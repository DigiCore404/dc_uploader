# Generate .env with: bash setup.sh --media /srv/media
# Installation options only. Manage uploader settings in the browser.
IMAGE=ghcr.io/digicore404/dc_uploader:edge
MEDIA_DIR=/srv/media
STATE_DIR=./workspace
PUID=1000
PGID=1000
# Local access by default. Set 0.0.0.0 to allow LAN access.
BIND_IP=127.0.0.1
PORT=6080
# setup.sh generates a unique password. Never publish your filled .env.
DIGITALCORE_WEB_PASSWORD=
